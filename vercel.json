{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/(feed|api)/(.*)\\.json",
      "headers": {
        "Cache-Control": "public, max-age=300, stale-while-revalidate=600",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "/(nadal|icons)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "rap.skene.info"
        }
      ],
      "dest": "/rap/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "klubi.skene.info"
        }
      ],
      "dest": "/klubi/$1"
    },
    {
      "src": "/api/(events|archive)\\.json",
      "dest": "/feed/$1.json"
    },
    {
      "src": "/tagasiside",
      "dest": "/tagasiside.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
