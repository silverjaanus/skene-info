{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' https://*.skene.info data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://*.skene.info https://api.web3forms.com; form-action 'self' https://api.web3forms.com; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "/(feed|api)/(.*)\\.json",
      "headers": {
        "Cache-Control": "public, max-age=300, stale-while-revalidate=600",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "/(nadal|icons)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "rap.skene.info"
        }
      ],
      "dest": "/rap/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "klubi.skene.info"
        }
      ],
      "dest": "/klubi/$1"
    },
    {
      "src": "/api/(events|archive)\\.json",
      "dest": "/feed/$1.json"
    },
    {
      "src": "/tagasiside",
      "dest": "/tagasiside.html"
    },
    {
      "src": "/dash",
      "dest": "/dash.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
